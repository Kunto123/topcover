# Konfigurasi aplikasi verifikasi casing. Salin menjadi .env. Jangan simpan rahasia di repo.
CASING_HOST=127.0.0.1
CASING_PORT=8000
CASING_LOG_LEVEL=INFO
CASING_LOG_DIR=data/logs
CASING_DEBUG=false

# Database lokal (isi di .env lokal saja; jangan commit kredensial)
# CASING_LOCAL_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/casing

# Kamera dan gambar
CASING_CAMERA_ENABLED=true
CASING_CAMERA_INDEX=0
CASING_CAMERA_BACKEND=auto
CASING_CAMERA_WIDTH=1920
CASING_CAMERA_HEIGHT=1080
CASING_CAMERA_FPS=30
CASING_PREVIEW_FPS=10
CASING_PREVIEW_WIDTH=960
CASING_JPEG_QUALITY=92
CASING_IMAGE_DIR=data/images

# Printer (saat ini hanya simulasi)
CASING_PRINTER_MODE=dryrun

# Penangkap scanner (ms / jumlah karakter)
CASING_SCAN_INTERVAL_MS=50
CASING_SCAN_MIN_LENGTH=3
CASING_SCAN_IDLE_FLUSH_MS=150

# Database pabrik (nonaktif = siklus tidak bisa menyimpan; tiruan = uji; postgres = nyata)
CASING_FACTORY_MODE=nonaktif
# CASING_FACTORY_DATABASE_URL=postgresql://akun@host/db?sslmode=verify-full&sslrootcert=/path/ca.pem
# CASING_FACTORY_MAPPING_FILE=D:/config/pemetaan_pabrik.json
CASING_FACTORY_CONNECT_TIMEOUT_S=2
CASING_FACTORY_WRITE_TIMEOUT_S=3

# Auth
CASING_AUTH_WAJIB=true
CASING_SESI_IDLE_MENIT=30
CASING_LOGIN_MAKS_GAGAL=5
CASING_LOGIN_KUNCI_MENIT=15

# Inferensi dan model
CASING_INFERENCE_WAJIB=true
CASING_INFERENCE_DEVICE=CPU
CASING_INFERENCE_AMBANG_DETEKSI=0.25
CASING_INFERENCE_AMBANG_MASK=0.5
CASING_INFERENCE_MAKS_DETEKSI=20
CASING_MODEL_DIR=data/models
CASING_MODEL_UPLOAD_MAKS_MB=500

# Siklus dan pembersihan gambar
CASING_SIKLUS_RUNNER_AKTIF=true
CASING_SIKLUS_TIMEOUT_INFERENSI_S=6
CASING_RETENSI_AKTIF=true
CASING_RETENSI_INTERVAL_MENIT=60